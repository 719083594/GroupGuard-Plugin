  "configs": [
    {
      "id": "groupguard",
      "file": "config/local.json",
      "reload": "hot",
      "defaults": {
        "masters": [],
        "managementGroups": [],
        "notifyUsers": [],
        "inviteMode": "off",
        "allowInviterConfirm": false,
        "allowAdminInvite": false,
        "notifyInviter": false,
        "requestExpireMinutes": 5,
        "maxPendingRequests": 20,
        "blackGroups": [],
        "whiteGroups": [],
        "autoQuitEnabled": false,
        "minGroupMember": 10,
        "autoQuitTime": "00:00",
        "autoQuitMessage": "本群成员 {memberCount} 人，未达到 {minMember} 人，机器人将退出。",
        "schemaVersion": 2,
        "newsSources": [],
        "legacy": {},
        "timezone": "Asia/Shanghai",
        "groups": []
      },
      "fields": [
        {
          "path": "masters",
          "label": "插件主人 QQ（只手动修改）",
          "type": "array",
          "scope": "global",
          "chatWritable": false,
          "sensitive": false,
          "items": {
            "type": "string",
            "format": "qq-or-group-id"
          },
          "maxItems": 5000,
          "editPolicy": "manual-file-only",
          "description": "只手动编辑 config/local.json；普通命令识别 isMaster 或 masters，自动退群豁免只读 masters。"
        },
        {
          "path": "managementGroups",
          "label": "审核管理群",
          "type": "array",
          "scope": "global",
          "chatWritable": true,
          "sensitive": false,
          "items": {
            "type": "string",
            "format": "qq-or-group-id"
          },
          "maxItems": 5000
        },
        {
          "path": "notifyUsers",
          "label": "私聊通知与审核用户",
          "type": "array",
          "scope": "global",
          "chatWritable": true,
          "sensitive": false,
          "items": {
            "type": "string",
            "format": "qq-or-group-id"
          },
          "maxItems": 5000
        },
        {
          "path": "inviteMode",
          "label": "机器人邀请审核模式",
          "type": "string",
          "scope": "global",
          "chatWritable": true,
          "sensitive": false,
          "enum": [
            "off",
            "manual",
            "accept",
            "reject"
          ]
        },
        {
          "path": "allowInviterConfirm",
          "label": "邀请者自行确认",
          "type": "boolean",
          "scope": "global",
          "chatWritable": true,
          "sensitive": false
        },
        {
          "path": "allowAdminInvite",
          "label": "管理员邀请免审",
          "type": "boolean",
          "scope": "global",
          "chatWritable": true,
          "sensitive": false
        },
        {
          "path": "notifyInviter",
          "label": "通知邀请人",
          "type": "boolean",
          "scope": "global",
          "chatWritable": true,
          "sensitive": false
        },
        {
          "path": "requestExpireMinutes",
          "label": "请求过期分钟数",
          "type": "integer",
          "scope": "global",
          "chatWritable": true,
          "sensitive": false,
          "min": 1,
          "max": 60
        },
        {
          "path": "maxPendingRequests",
          "label": "实例共用待审上限",
          "type": "integer",
          "scope": "global",
          "chatWritable": true,
          "sensitive": false,
          "min": 1,
          "max": 100
        },
        {
          "path": "blackGroups",
          "label": "群黑名单",
          "type": "array",
          "scope": "global",
          "chatWritable": true,
          "sensitive": false,
          "items": {
            "type": "string",
            "format": "qq-or-group-id"
          },
          "maxItems": 5000
        },
        {
          "path": "whiteGroups",
          "label": "群白名单",
          "type": "array",
          "scope": "global",
          "chatWritable": true,
          "sensitive": false,
          "items": {
            "type": "string",
            "format": "qq-or-group-id"
          },
          "maxItems": 5000
        },
        {
          "path": "autoQuitEnabled",
          "label": "自动退群",
          "type": "boolean",
          "scope": "global",
          "chatWritable": true,
          "sensitive": false,
          "description": "入群事件由全局开关控制；每日巡检只处理已配置并启用的群。"
        },
        {
          "path": "minGroupMember",
          "label": "最低群人数",
          "type": "integer",
          "scope": "global",
          "chatWritable": true,
          "sensitive": false,
          "min": 1,
          "max": 10000
        },
        {
          "path": "autoQuitTime",
          "label": "退群巡检时间",
          "type": "string",
          "scope": "global",
          "chatWritable": true,
          "sensitive": false,
          "format": "HH:mm"
        },
        {
          "path": "autoQuitMessage",
          "label": "退群提示模板",
          "type": "string",
          "scope": "global",
          "chatWritable": true,
          "sensitive": false,
          "maxLength": 2000
        },
        {
          "path": "schemaVersion",
          "label": "配置结构版本",
          "type": "integer",
          "scope": "global",
          "chatWritable": false,
          "sensitive": false,
          "editPolicy": "internal",
          "hidden": true
        },
        {
          "path": "newsSources",
          "label": "按机器人与群隔离的新闻来源",
          "type": "array",
          "scope": "global",
          "chatWritable": false,
          "sensitive": true,
          "editPolicy": "browser-only",
          "maxItems": 1000,
          "description": "浏览器管理界面按精确机器人与群维护；不允许聊天 setter 或通配来源。",
          "keyWriteContract": {
            "actions": [
              "keep",
              "replace",
              "clear"
            ],
            "defaultAction": "keep",
            "readView": "hasKey only"
          },
          "fields": [
            {
              "name": "botId",
              "type": "string",
              "format": "qq-id",
              "sensitive": false
            },
            {
              "name": "groupId",
              "type": "string",
              "format": "group-id",
              "sensitive": false
            },
            {
              "name": "url",
