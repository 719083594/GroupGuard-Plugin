{
  "schemaVersion": 2,
  "id": "groupguard",
  "title": "GroupGuard-Plugin 群管",
  "version": "2.1.0",
  "description": "独立 TRSS＋NapCat 群管理插件：成员权限、审核、撤回、统计、新闻、点赞与浏览器配置",
  "runtime": {
    "framework": "TRSS",
    "adapter": "OneBot v11",
    "provider": "NapCat",
    "entry": "index.js",
    "node": ">=20",
    "independentHttp": false
  },
  "permissions": {
    "master": "TRSS isMaster === true 或手动配置的 masters；自动退群主人豁免只读取 masters",
    "enforcement": "core-and-entry"
  },
  "commands": [
    "#群管帮助 [文字]",
    "#群管版本",
    "#群管状态 [文字]",
    "#群管开启",
    "#群管关闭",
    "#群管设置 <字段> <值>",
    "#群管黑名单 [添加|删除 <QQ>]",
    "#群管白名单 [添加|删除 <QQ>]",
    "#群管禁言 @成员 [时长]",
    "#群管解禁 @成员",
    "#群管踢 @成员",
    "#群管全体禁言",
    "#群管全体解禁",
    "#群管撤回（引用）或 #群管撤回 @成员 [条数]",
    "#群管设管理 @成员",
    "#群管撤管理 @成员",
    "#群管头衔 @成员 <头衔>",
    "#群管今日榜",
    "#群管昨日榜",
    "#群管月榜",
    "#群管日报",
    "#群管待审核",
    "#群管同意 [请求编号]（也可引用通知）",
    "#群管拒绝 [请求编号]（也可引用通知）",
    "#群管全局 <字段> <值>",
    "#群管群黑名单 [添加|删除 <群号>]",
    "#群管群白名单 [添加|删除 <群号>]",
    "#群管更新日志",
    "#群管更新",
    "#群管日志",
    "赞我",
    "撤回",
    "禁言 @成员 [时长]",
    "解禁 @成员"
  ],
